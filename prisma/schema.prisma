generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DashboardHandler {
  id        String   @id @default(uuid())
  date      String
  items     String   
}

model User {
  id        String   @id @default(cuid())
  idNumber  String   @unique                     
  password  String
  username  String?
  userImg   String?
  role       Role     @default(student)
  createdAt  DateTime @default(now())
}

enum Role {
  staff
  student
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sender    String   
  senderId  String
  receiverId String
  text      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([receiverId])
  @@index([expiresAt])
}